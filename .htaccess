# =============================================================================
# リポジトリのルートの .htaccess（保険）
#
#   公開ルートは public/ にする（~/www/postcode → ~/apps/postcode/current/public）。
#   それでも、何かの理由でリポジトリのルートが公開されてしまった場合に備えて、
#   すべての URL を public/ の中に振り分ける。これで config.php・src/・vendor/ などは、URL から開けない。
#   ※ 公開ルートが public/ になっていれば、このファイルは読まれない
# =============================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# mod_rewrite が使えない場合は、何も見せない（設定ファイルなどを見せるよりは安全）
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

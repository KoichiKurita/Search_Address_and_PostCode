# =============================================================================
# 郵便番号・住所検索 Apache 設定（.htaccess）
#   本番: さくらのレンタルサーバ / 開発: Docker（php:8.3-apache）
#   mod_headers・mod_rewrite が無い環境でも 500 エラーにならないよう、IfModule で囲む
# =============================================================================

# ディレクトリの中身を一覧表示しない（index ファイルが無いフォルダを開いたとき）
Options -Indexes

# -----------------------------------------------------------------------------
# アクセス制限（#17）
#   設定ファイル・関数ファイル・隠しファイル・開発用ファイルは、URL を直接開いても見せない（403）
#   ※ js/config.js はブラウザが読み込むので、ここでは拒否しない
# -----------------------------------------------------------------------------
<FilesMatch "^(config|config_dummy|functions)\.php$">
    Require all denied
</FilesMatch>

# 「.」で始まるファイル（.htaccess・.env・.gitignore など）
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ドキュメント・SQL・スクリプトなど（デプロイ対象から外しているが、念のため二重に守る）
<FilesMatch "\.(md|sql|py|sh|txt|example|ini|yml|yaml|lock|log|bak)$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# HTTP → HTTPS へのリダイレクト
#   さくらのレンタルサーバでは HTTPS がプロキシ経由になるため、%{HTTPS} では判定できない。
#   HTTPS のときだけ付く X-Sakura-Forwarded-For ヘッダーが「無い」ことで HTTP と判定する。
#   Docker（localhost）で誤ってリダイレクトしないよう、ホスト名が *.sakura.ne.jp のときだけ行う。
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} \.sakura\.ne\.jp$ [NC]
    RewriteCond %{ENV:HTTPS} !^on$
    RewriteCond %{HTTP:X-Sakura-Forwarded-For} ^$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# セキュリティヘッダ（#18）
#   always を付けると、エラー（4xx・5xx）やリダイレクトの応答にも付く
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # 読み込んでよいリソースを自サイトだけに限定する（XSS 対策）
    #   インラインの <script> や style 属性を使っていないので、'unsafe-inline' を付けずに済んでいる
    #   frame-ancestors 'none' … 他サイトの iframe に埋め込ませない（クリックジャッキング対策）
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"

    # Content-Type を推測させない（例: 画像として送ったファイルを、スクリプトとして実行させない）
    Header always set X-Content-Type-Options "nosniff"

    # iframe への埋め込みを禁止する（CSP の frame-ancestors に対応していない古いブラウザ向け）
    Header always set X-Frame-Options "DENY"

    # 他サイトへ移動するとき、URL（検索した郵便番号など）を送らない
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # このサイトでは使わないブラウザの機能を無効にする
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # 一度 HTTPS で接続したら、以後は HTTPS だけを使わせる（HSTS）
    #   まずは短い期間（1日）で動作を確認し、問題がなければ 31536000（1年）に延ばす
    #   初期ドメイン（*.sakura.ne.jp）を使っているため、includeSubDomains と preload は付けない
    Header always set Strict-Transport-Security "max-age=86400"
</IfModule>

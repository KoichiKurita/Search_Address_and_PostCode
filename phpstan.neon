# PHPStan（静的解析）の設定  make stan で実行する
#   level max: 最も厳しいレベル。型の決まっていない値（mixed）をそのまま使うと指摘される
#   DB から取り出した値は Repository（src/Infrastructure）の中で型を確かめ、外には型の決まった値だけを出している
parameters:
    level: max
    paths:
        - src
        - tests
        - functions.php
        - get_municipality.php
        - result_address.php
        - result_postcode.php
        - search_postcode.php
    # config.php は Git 管理外なので、定数（DB_NAME など）の定義には Docker 用の設定ファイルを使う
    bootstrapFiles:
        - docker/app/config.php

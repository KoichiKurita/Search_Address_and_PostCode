# PHPStan（静的解析）の設定  make stan で実行する
#   level 9: 型の扱いを厳しく確認する（mixed 型の値をそのまま使うと指摘される）
#   最も厳しい max は、DB から取り出した行の型が決まっていないため、
#   Phase 4 で Repository 層（型付きのオブジェクトで行を返す）を作ってから目指す
parameters:
    level: 9
    paths:
        - src
        - tests
        - functions.php
        - get_municipality.php
        - result_address.php
        - result_postcode.php
        - search_postcode.php
    # config.php は Git 管理外なので、定数（DB_NAME など）の定義には Docker 用の設定ファイルを使う
    bootstrapFiles:
        - docker/app/config.php

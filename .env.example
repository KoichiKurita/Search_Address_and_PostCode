# ローカル開発環境の設定（make init で .env にコピーされる）
# .env は Git 管理外。ここに本番の値は書かないこと。
APP_PORT=8080
PMA_PORT=8081
DB_PORT=3307

DB_DATABASE=postcode

# アプリ（PHP）が使う参照専用ユーザー（SELECT だけ）
DB_READONLY_USERNAME=app_ro
DB_READONLY_PASSWORD=app_ro_password

# データ投入（make seed-full）・管理（make db）用のユーザー（この DB の全権限）
DB_LOADER_USERNAME=loader
DB_LOADER_PASSWORD=loader_password

MYSQL_ROOT_PASSWORD=root_password

# 自動デプロイ用の Secrets / Variables（setup.py secrets で GitHub に登録する）
# このファイルを deploy.env という名前でコピーして値を入れる。deploy.env は Git 管理外。

# --- Secrets（暗号化して保存される） ---
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
# 秘密鍵・ホスト鍵はファイルのパスで指定する（中身は画面に表示されない）
SSH_PRIVATE_KEY_FILE=~/deploy_key
SSH_KNOWN_HOSTS_FILE=~/deploy_known_hosts

# --- Variables（平文で保存される） ---
DEPLOY_PORT=22
APP_DIR=/var/www/postcode
APP_URL=https://example.com/postcode
RELOAD_SERVICE=php8.3-fpm

# 自動デプロイ用の Secrets / Variables（setup.py secrets で GitHub に登録する）
# このファイルを deploy.env という名前でコピーして値を入れる。deploy.env は Git 管理外。

# --- Secrets（暗号化して保存される） ---
# さくらのレンタルサーバの「初期ドメイン」とアカウント名（コントロールパネルで確認）
DEPLOY_HOST=<アカウント名>.sakura.ne.jp
DEPLOY_USER=<アカウント名>
# 秘密鍵・ホスト鍵はファイルのパスで指定する（中身は画面に表示されない）
SSH_PRIVATE_KEY_FILE=~/deploy_key
SSH_KNOWN_HOSTS_FILE=~/deploy_known_hosts

# --- Variables（平文で保存される） ---
DEPLOY_PORT=22
APP_DIR=/home/<アカウント名>/apps/postcode
APP_URL=https://<アカウント名>.sakura.ne.jp/postcode

# サーバーの PHP のコマンド（郵便番号データの月次更新で使う。DEPLOY.md の 7 を参照）
# ssh で「php -v」が 8.3 なら php のままでよい。違う版なら 8.3 のコマンドのフルパスを書く
PHP_CLI=php

# --- デプロイの停止スイッチ（リポジトリ全体の Variable。false にするとデプロイしない） ---
DEPLOY_ENABLED=true
